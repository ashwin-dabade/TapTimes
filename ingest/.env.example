# Copy to ingest/.env for local runs. Never commit the real .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GUARDIAN_API_KEY=

# gemini (default) or groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional overrides
